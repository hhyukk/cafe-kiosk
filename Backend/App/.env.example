# 점주 토큰의 HS256 서명 키. 32바이트 이상의 난수를 base64 로 적는다
# Git Bash 에서 openssl rand -base64 32 를 실행해 나온 줄을 그대로 붙인다
JWT_SECRET=

# dev 프로필이 기동할 때 심는 점주 계정. 이 이메일과 비밀번호로 로그인한다
OWNER_EMAIL=owner@cafe.com
OWNER_PASSWORD=
